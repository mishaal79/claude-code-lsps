{
  "tailwindcss": {
    "command": "tailwindcss-language-server",
    "args": ["--stdio"],
    "languages": ["html", "css", "javascriptreact", "typescriptreact", "vue", "svelte", "astro"],
    "fileExtensions": [".html", ".css", ".jsx", ".tsx", ".vue", ".svelte", ".astro"],
    "transport": "stdio",
    "settings": {},
    "maxRestarts": 3
  }
}
