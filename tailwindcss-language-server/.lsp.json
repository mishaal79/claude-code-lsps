{
  "tailwindcss": {
    "command": "tailwindcss-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".html": "html",
      ".css": "css",
      ".jsx": "javascriptreact",
      ".tsx": "typescriptreact",
      ".vue": "vue",
      ".svelte": "svelte",
      ".astro": "astro"
    },
    "transport": "stdio",
    "settings": {},
    "maxRestarts": 3
  }
}
