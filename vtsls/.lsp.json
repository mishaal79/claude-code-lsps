{
  "typescript": {
    "command": "vtsls",
    "args": ["--stdio"],
    "languages": [
      "typescript",
      "javascript",
      "typescriptreact",
      "javascriptreact",
      "vue",
      "svelte",
      "astro"
    ],
    "fileExtensions": [
      ".ts", ".tsx", ".mts", ".cts",
      ".js", ".jsx", ".mjs", ".cjs",
      ".vue",
      ".svelte",
      ".astro"
    ],
    "transport": "stdio",
    "settings": {},
    "maxRestarts": 3
  }
}
