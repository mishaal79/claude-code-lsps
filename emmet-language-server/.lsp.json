{
  "emmet": {
    "command": "emmet-language-server",
    "args": ["--stdio"],
    "languages": ["html", "css", "scss", "sass", "less", "javascriptreact", "typescriptreact", "vue", "svelte"],
    "fileExtensions": [".html", ".css", ".scss", ".sass", ".less", ".jsx", ".tsx", ".vue", ".svelte"],
    "transport": "stdio",
    "settings": {},
    "maxRestarts": 3
  }
}
